<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:titleTextColor="@color/text_primary"
        app:navigationIconTint="@color/text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Aim Line Length -->
            <TextView
                android:id="@+id/textLineLength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Line Length: 800px"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/sliderLineLength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary" />

            <!-- Line Thickness -->
            <TextView
                android:id="@+id/textLineThickness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Line Thickness: 3dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/sliderLineThickness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary" />

            <!-- Glow Intensity -->
            <TextView
                android:id="@+id/textGlow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Glow Intensity: 50%"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/sliderGlow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary" />

            <!-- Detection Sensitivity -->
            <TextView
                android:id="@+id/textSensitivity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sensitivity: 50%"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/sliderSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary" />

            <!-- Info -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Adjust the aim line overlay to match your preference. Higher sensitivity detects more balls but may have false positives."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="RESET"
            android:layout_marginEnd="8dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/text_secondary"
            app:cornerRadius="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="SAVE"
            android:layout_marginStart="8dp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="24dp" />

    </LinearLayout>

</LinearLayout>
